[data-molecule] { width: 320px; height: 240px; position: relative; margin: 1rem auto; }

[data-abc] { margin: 1rem 0px; }

[data-logic-circuit] svg, [data-schematic] svg { max-width: 100%; height: auto; }

@media print {
}

