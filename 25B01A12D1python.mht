-1 mb-3" data-ref="28ba508e-f55c-444d-8ce8-693a5ce1fb97"><b style="border-bottom:1px solid black;" data-ref="3a768fc9-883e-4169-8f75-38bdd680094f" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="05eb4872-55e9-4a18-95f2-ded259ad3b58" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="b1da24e3-e65d-472a-ae03-d84575630ce5" data-undisplayed="undisplayed">numpyarr.py</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="df3248f0-6b6f-44f5-a5f6-e945907c6714" data-undisplayed="undisplayed">import numpy as np
